# Supabase > Connect > Transaction pooler (port 6543). Keep server-side only.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# The first account created with this username becomes admin.
ADMIN_USERNAME=rio
# Optional locally. Vercel automatically serves HTTPS and sets VERCEL=1.
COOKIE_SECURE=1
REQUIRE_TERMS=1
